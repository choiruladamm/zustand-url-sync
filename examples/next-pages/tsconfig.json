{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "incremental": true,
    "noEmit": true,
    "paths": {
      "zustand": ["../../node_modules/zustand"],
      "zustand/*": ["../../node_modules/zustand/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"],
  "_note": "The library is symlinked, so its .d.ts resolves zustand from the repo root. Point the example at that same copy or the StoreMutators augmentation lands on a different interface."
}
